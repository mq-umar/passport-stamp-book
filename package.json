{
  "name": "passport-stamp-book",
  "version": "1.0.0",
  "description": "A concept stamp-book for everyday trips and meals, styled as a physical passport. Fake data only.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/unit/*.test.js server.test.js",
    "test:ui": "node --test tests/ui/app.ui.mjs tests/ui/a11y.ui.mjs tests/ui/api.ui.mjs",
    "test:all": "npm run lint && npm test && npm run test:ui && npm run test:layout",
    "test:layout": "node --test tests/ui/layout.ui.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "puppeteer-core": "^25.18.1"
  }
}
